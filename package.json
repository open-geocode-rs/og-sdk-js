{
  "name": "og-sdk-js",
  "private": true,
  "workspaces": [
    "packages/*",
    "ecosystem-tests/*"
  ],
  "type": "module",
  "scripts": {
    "gen": "openapi-typescript https://raw.githubusercontent.com/open-geocode-rs/open-geocode/main/contract/openapi.json -o packages/client/src/schema.gen.ts",
    "build": "bun run --filter '@open-geocode/client' build && bun run --filter '@open-geocode/autocomplete-core' build && bun run --filter '@open-geocode/autocomplete' build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "vitest run --project client --project autocomplete-core",
    "test:browser": "vitest run --project autocomplete",
    "changeset": "changeset",
    "release": "bun run build && changeset publish",
    "check:packages": "for p in packages/*; do bunx publint $p --strict && bunx attw --pack $p --profile esm-only || exit 1; done",
    "size": "size-limit",
    "docs": "typedoc",
    "test:ecosystem": "cd ecosystem-tests/vite && vite build --logLevel warn && cd ../treeshake && node check.mjs && cd ../runtimes && node smoke.mjs && bun smoke.mjs && bunx deno run --allow-read --allow-env smoke.mjs",
    "docs:capabilities": "bun packages/client/scripts/write-capabilities.ts && oxfmt packages/client/README.md",
    "docs:page": "bun packages/client/scripts/capabilities-page.ts"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^3.0.3",
    "@size-limit/preset-small-lib": "^14.3.0",
    "@types/node": "^26.6.6",
    "@vitest/browser-playwright": "^5.1.0",
    "openapi-typescript": "^7.13.0",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "playwright": "^1.65.1",
    "publint": "^0.3.25",
    "size-limit": "^14.3.0",
    "tsdown": "^0.23.7",
    "typedoc": "^0.28.20",
    "typescript": "~6.0.3",
    "unrun": "^0.3.1",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "size-limit": [
    {
      "name": "Geocoder with the og adapter",
      "path": [
        "packages/client/dist/index.js",
        "packages/client/dist/og.js"
      ],
      "import": {
        "packages/client/dist/index.js": "{ Geocoder }",
        "packages/client/dist/og.js": "{ og }"
      },
      "limit": "6.7 kB"
    },
    {
      "name": "Geocoder with the google adapter",
      "path": [
        "packages/client/dist/index.js",
        "packages/client/dist/google.js"
      ],
      "import": {
        "packages/client/dist/index.js": "{ Geocoder }",
        "packages/client/dist/google.js": "{ google }"
      },
      "limit": "8.2 kB"
    },
    {
      "name": "Geocoder with the mapbox adapter",
      "path": [
        "packages/client/dist/index.js",
        "packages/client/dist/mapbox.js"
      ],
      "import": {
        "packages/client/dist/index.js": "{ Geocoder }",
        "packages/client/dist/mapbox.js": "{ mapbox }"
      },
      "limit": "7.7 kB"
    },
    {
      "name": "Geocoder with the here adapter",
      "path": [
        "packages/client/dist/index.js",
        "packages/client/dist/here.js"
      ],
      "import": {
        "packages/client/dist/index.js": "{ Geocoder }",
        "packages/client/dist/here.js": "{ here }"
      },
      "limit": "10 kB"
    },
    {
      "name": "Geocoder with the precisely adapter",
      "path": [
        "packages/client/dist/index.js",
        "packages/client/dist/precisely.js"
      ],
      "import": {
        "packages/client/dist/index.js": "{ Geocoder }",
        "packages/client/dist/precisely.js": "{ precisely }"
      },
      "limit": "9.6 kB"
    },
    {
      "name": "failover, cache and compare",
      "path": "packages/client/dist/plugins.js",
      "import": "{ cache, compare, failover }",
      "limit": "2.4 kB"
    },
    {
      "name": "og's native client alone",
      "path": "packages/client/dist/og.js",
      "import": "{ createClient }",
      "limit": "2.5 kB"
    },
    {
      "name": "@open-geocode/autocomplete-core",
      "path": "packages/autocomplete-core/dist/index.js",
      "import": "{ createAutocomplete }",
      "limit": "1 kB"
    },
    {
      "name": "@open-geocode/autocomplete-core with geocoderSource",
      "path": "packages/autocomplete-core/dist/index.js",
      "import": "{ createAutocomplete, geocoderSource }",
      "limit": "1.2 kB"
    },
    {
      "name": "@open-geocode/autocomplete (CDN file)",
      "path": "packages/autocomplete/dist/og-autocomplete.iife.js",
      "limit": "9 kB"
    }
  ]
}
