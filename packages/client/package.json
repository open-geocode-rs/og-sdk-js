{
  "name": "@open-geocode/client",
  "version": "0.0.0",
  "description": "The client for open-geocode, and clients that speak the Google, Mapbox, HERE and Precisely APIs against og or the vendor. Typed, tree-shakeable, no runtime dependencies.",
  "keywords": [
    "autocomplete",
    "geocoder",
    "geocoding",
    "open-geocode",
    "places",
    "reverse-geocoding"
  ],
  "homepage": "https://opengeocode.com/docs/guides/typescript/",
  "bugs": "https://github.com/open-geocode-rs/og-sdk-js/issues",
  "license": "Apache-2.0",
  "author": "Abhigyaan Jha and the open-geocode contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/open-geocode-rs/og-sdk-js.git",
    "directory": "packages/client"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./google": {
      "types": "./dist/google.d.ts",
      "default": "./dist/google.js"
    },
    "./mapbox": {
      "types": "./dist/mapbox.d.ts",
      "default": "./dist/mapbox.js"
    },
    "./here": {
      "types": "./dist/here.d.ts",
      "default": "./dist/here.js"
    },
    "./precisely": {
      "types": "./dist/precisely.d.ts",
      "default": "./dist/precisely.js"
    },
    "./plugins": {
      "types": "./dist/plugins.d.ts",
      "default": "./dist/plugins.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "prepack": "node -e \"for (const f of ['LICENSE', 'NOTICE']) require('node:fs').copyFileSync('../../' + f, f)\""
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
