{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "ignorePatterns": ["dist", "**/schema.gen.ts"],
  "rules": {
    "no-underscore-dangle": [
      "warn",
      {
        "allow": ["_request_id"]
      }
    ]
  }
}
